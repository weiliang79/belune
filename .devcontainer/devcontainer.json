{
  "name": "belune API",
  "dockerComposeFile": ["../infra/docker-compose.yml", "docker-compose.yml"],
  "service": "api",
  "workspaceFolder": "/workspaces/belune",
  "initializeCommand": "mkdir -p /var/tmp/belune-builds && docker network create belune-infra 2>/dev/null || true",
  "forwardPorts": [8080],
  "portsAttributes": {
    "9090": {
      "label": "api-metrics (internal)",
      "onAutoForward": "ignore"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "installZsh": false,
      "installOhMyZsh": false,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26"
    }
  },
  "postCreateCommand": "bash /workspaces/belune/.devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "task.vscode-task"
      ]
    }
  },
  "remoteUser": "vscode",
  "shutdownAction": "stopCompose"
}
