{
  "name": "selfhost-paas API",
  "dockerComposeFile": ["../infra/docker-compose.yml", "docker-compose.yml"],
  "service": "api",
  "workspaceFolder": "/workspaces/selfhost-paas",
  "initializeCommand": "mkdir -p /var/tmp/paas-builds && docker network create paas-infra 2>/dev/null || true",
  "forwardPorts": [8080],
  "postCreateCommand": "bash /workspaces/selfhost-paas/.devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "task.vscode-task"
      ]
    }
  },
  "remoteUser": "vscode",
  "shutdownAction": "stopCompose"
}
