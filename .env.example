# NOTE: When using the VS Code devcontainer, the following four vars are
# overridden by .devcontainer/docker-compose.yml (service-name DNS instead
# of localhost). You do not need to change them here for devcontainer use.

# Database
DATABASE_URL=postgres://belune:belune@localhost:5432/belune?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=8080

# Auth
JWT_SECRET=change-me-to-a-random-secret
# Access-token TTL in hours. Short by design — refresh tokens cover the gap.
JWT_EXPIRY_HOURS=1
# Refresh-token TTL in hours. Default 168 = 7 days.
JWT_REFRESH_HOURS=168

# Encryption (for env vars and database credentials at rest)
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key

# Caddy
# For TCP admin (default, dev): http://host:2019
# For Unix-socket admin (recommended for production — eliminates network exposure
# of the admin API): unix:///run/caddy/admin.sock
CADDY_ADMIN_URL=http://localhost:2019

# Where Caddy dials to reach this API. It is written into the dashboard and
# catch-all routes, so Caddy must be able to resolve it *from inside its own
# container* — which is why it is not localhost.
#
# In host dev the API runs on the host under air, so Caddy has to come back out
# to reach it. The default (belune:8080) is the compose service name and is
# correct only in production, where the API is a container on Caddy's network;
# left unset here, the dashboard domain answers 502.
#
# Not to be confused with BELUNE_DASHBOARD_UPSTREAM in infra/docker-compose.yml:
# that one is read by the Caddyfile inside the caddy container, and the API
# overwrites the route it produces with this value.
DASHBOARD_UPSTREAM=host.docker.internal:8080
# Docker container name of the Caddy reverse proxy. The deploy worker attaches
# this container to each project's network so Caddy can reverse-proxy to apps
# without sharing one big network across all projects.
CADDY_CONTAINER_NAME=infra-caddy-1

# Public IP of this server — the address a domain's DNS record must point at for
# a certificate to be issuable. Belune checks each domain against it and reports a
# mismatch on the TLS badge before Let's Encrypt ever gets involved. Leave unset
# to autodetect; autodetection is skipped behind NAT, which disables the check.
BELUNE_PUBLIC_IP=

# BuildKit (used by Railpack)
BUILDKIT_HOST=tcp://localhost:1234

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Cookies. Session cookies are marked Secure automatically on HTTPS requests;
# set this only to force it behind a proxy that does not set X-Forwarded-Proto.
SECURE_COOKIES=false

# Migration safety: when true, the API skips automatic schema migration on
# startup. Use this to bring the binary up without touching the schema while
# you repair it by hand (e.g. after a migration left the DB in 'dirty' state).
BELUNE_SKIP_MIGRATIONS=false