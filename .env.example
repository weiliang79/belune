# NOTE: When using the VS Code devcontainer, the following four vars are
# overridden by .devcontainer/docker-compose.yml (service-name DNS instead
# of localhost). You do not need to change them here for devcontainer use.

# Database
DATABASE_URL=postgres://belune:belune@localhost:5432/belune?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=8080

# Auth
JWT_SECRET=change-me-to-a-random-secret
# Access-token TTL in hours. Short by design — refresh tokens cover the gap.
JWT_EXPIRY_HOURS=1
# Refresh-token TTL in hours. Default 168 = 7 days.
JWT_REFRESH_HOURS=168

# Encryption (for env vars and database credentials at rest)
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key

# Caddy
# For TCP admin (default, dev): http://host:2019
# For Unix-socket admin (recommended for production — eliminates network exposure
# of the admin API): unix:///run/caddy/admin.sock
CADDY_ADMIN_URL=http://localhost:2019
# Docker container name of the Caddy reverse proxy. The deploy worker attaches
# this container to each project's network so Caddy can reverse-proxy to apps
# without sharing one big network across all projects.
CADDY_CONTAINER_NAME=infra-caddy-1

# BuildKit (used by Railpack)
BUILDKIT_HOST=tcp://localhost:1234

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Cookies
SECURE_COOKIES=false

# Migration safety: when true, the API skips automatic schema migration on
# startup. Use this to bring the binary up without touching the schema while
# you repair it by hand (e.g. after a migration left the DB in 'dirty' state).
BELUNE_SKIP_MIGRATIONS=false