# NOTE: When using the VS Code devcontainer, the following four vars are
# overridden by .devcontainer/docker-compose.yml (service-name DNS instead
# of localhost). You do not need to change them here for devcontainer use.

# Database
DATABASE_URL=postgres://paas:paas@localhost:5432/paas?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=8080

# Auth
JWT_SECRET=change-me-to-a-random-secret
# Access-token TTL in hours. Short by design — refresh tokens cover the gap.
JWT_EXPIRY_HOURS=1
# Refresh-token TTL in hours. Default 168 = 7 days.
JWT_REFRESH_HOURS=168

# Encryption (for env vars and database credentials at rest)
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key

# Caddy
CADDY_ADMIN_URL=http://localhost:2019

# BuildKit (used by Railpack)
BUILDKIT_HOST=tcp://localhost:1234

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Cookies
SECURE_COOKIES=false