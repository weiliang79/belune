# Database
DATABASE_URL=postgres://paas:paas@localhost:5432/paas?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=8080

# Auth
JWT_SECRET=change-me-to-a-random-secret

# Encryption (for env vars and database credentials at rest)
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key

# Caddy
CADDY_ADMIN_URL=http://localhost:2019

# BuildKit (used by Railpack)
BUILDKIT_HOST=tcp://localhost:1234