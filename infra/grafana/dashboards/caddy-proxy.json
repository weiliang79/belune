{
  "uid": "belune-caddy",
  "title": "Caddy Proxy",
  "tags": ["belune", "caddy"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (code) (rate(caddy_http_requests_total[5m]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Upstream p95 latency",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (upstream, le) (rate(caddy_reverse_proxy_upstreams_duration_seconds_bucket[5m])))",
          "legendFormat": "{{upstream}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "TLS handshakes",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (result) (rate(caddy_tls_handshakes_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Caddy admin calls from PaaS API",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (op, result) (rate(belune_caddy_admin_calls_total[5m]))",
          "legendFormat": "{{op}} ({{result}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "4xx / 5xx rate",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(caddy_http_requests_total{code=~\"4..\"}[5m]))",
          "legendFormat": "4xx"
        },
        {
          "expr": "sum(rate(caddy_http_requests_total{code=~\"5..\"}[5m]))",
          "legendFormat": "5xx"
        }
      ]
    }
  ]
}
