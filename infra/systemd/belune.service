[Unit]
Description=Belune (docker compose stack)
Documentation=https://github.com/weiliang79/belune/blob/main/docs/runbooks/install.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/belune

# Up brings the stack up; compose `restart: unless-stopped` then handles
# per-container respawn. Stop is graceful so volumes stay intact.
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose pull && /usr/bin/docker compose up -d

# Give compose enough time on a slow disk to start postgres/redis healthchecks.
TimeoutStartSec=120
TimeoutStopSec=60

# Don't restart the unit itself — Type=oneshot + RemainAfterExit means
# systemd treats successful ExecStart as "active". Container-level restart
# is the compose engine's job.
Restart=no

[Install]
WantedBy=multi-user.target
