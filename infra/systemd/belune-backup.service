[Unit]
Description=Belune — nightly backup
Documentation=https://github.com/weiling79/belune/blob/main/docs/runbooks/backup-storage.md
After=docker.service belune.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/belune
ExecStart=/bin/bash /opt/belune/scripts/backup.sh

# Allow up to 10 minutes for large databases.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
