[Unit]
Description=Belune — manual/CLI control-plane backup (daily backups run in-app; see Server → Backups)
Documentation=https://github.com/weiliang79/belune/blob/main/docs/runbooks/backup-storage.md
After=docker.service belune.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/belune
ExecStart=/bin/bash /opt/belune/scripts/backup.sh

# Allow up to 10 minutes for large databases.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
