[Unit]
Description=Daily backup timer for Self-Hosted PaaS
After=belune.service

[Timer]
# Run once a day at 02:00 local time.
OnCalendar=*-*-* 02:00:00
# Fire immediately on next boot if last trigger was missed (host was down).
Persistent=true
Unit=belune-backup.service

[Install]
WantedBy=timers.target
