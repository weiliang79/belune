# Self-Hosted PaaS — full environment reference
#
# This file is the canonical list of every variable the API recognises. It is
# NOT loaded automatically — the installer writes a small `.env` containing
# only the secrets and overrides that need to differ from these defaults.
# Copy a value from here into `.env` only when you need to override it.
#
# Variables marked REQUIRED have no safe default; the installer generates
# them. Variables marked DEV-ONLY should not be set in production.

# ─────────────────────────────────────────────────────────────────────────────
# Core: HTTP server
# ─────────────────────────────────────────────────────────────────────────────

# HTTP listener port. Default: 8080.
PORT=8080

# Comma-separated CORS origins for the dashboard. Add your panel hostname when
# you put it behind Caddy. Default: http://localhost:5173 (vite dev server).
CORS_ORIGINS=http://localhost:5173

# When true, sets HSTS headers and Secure cookies. Flip to true once Caddy is
# terminating TLS for the panel hostname. Default: false.
TLS_ENABLED=false
SECURE_COOKIES=false

# slog level: debug | info | warn | error. Default: info.
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Storage backends
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. PostgreSQL DSN. The compose stack uses service-name DNS.
DATABASE_URL=postgres://paas:paas@postgres:5432/paas?sslmode=disable

# REQUIRED. Redis URL. Used by asynq (task queue), pub/sub (build logs), and
# auth blacklist storage.
REDIS_URL=redis://redis:6379

# Migration kill-switch. Set to true to start the API without applying pending
# migrations — useful when an in-progress migration left the schema dirty and
# you want to repair it manually before letting the next binary touch it.
PAAS_SKIP_MIGRATIONS=false

# ─────────────────────────────────────────────────────────────────────────────
# Auth & cryptography
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. JWT signing secret. Must be at least 32 characters. Rotating this
# invalidates every active session.
JWT_SECRET=change-me-to-a-random-secret

# Access-token TTL (hours). Short by design — refresh tokens cover the gap.
# Default: 1.
JWT_EXPIRY_HOURS=1

# Refresh-token TTL (hours). Default: 168 (7 days).
JWT_REFRESH_HOURS=168

# REQUIRED (one of). Encryption key(s) for env-var values, git PATs, and DB
# credentials at rest. Two formats supported:
#
#   ENCRYPTION_KEY=<32-byte hex>
#       Single legacy key, promoted to v1. Use this for new installs.
#
#   ENCRYPTION_KEYS=v1:<hex>,v2:<hex>
#   ENCRYPTION_KEY_CURRENT=v2
#       Multi-key keyring for rotation. New writes use ENCRYPTION_KEY_CURRENT;
#       reads accept any key in the ring. See docs/runbooks/key-rotation.md.
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key
# ENCRYPTION_KEYS=
# ENCRYPTION_KEY_CURRENT=

# ─────────────────────────────────────────────────────────────────────────────
# Caddy reverse proxy
# ─────────────────────────────────────────────────────────────────────────────

# Caddy admin endpoint. Two transports supported:
#   http://caddy:2019           (TCP, default for the dev compose)
#   unix:///run/caddy/admin.sock (recommended for production — no network
#                                 exposure of the admin API)
CADDY_ADMIN_URL=http://caddy:2019

# Docker container name of Caddy. The deploy worker attaches Caddy to each
# project's network so it can reach apps without a shared global network.
CADDY_CONTAINER_NAME=infra-caddy-1

# Path to Caddy's JSON access log on disk. Used by the request-logs ingestor.
ACCESS_LOG_PATH=/var/log/caddy/access.log

# ─────────────────────────────────────────────────────────────────────────────
# Build pipeline
# ─────────────────────────────────────────────────────────────────────────────

# BuildKit endpoint for Railpack builds. Empty disables Railpack (Dockerfile
# and CNB still work). Default: tcp://buildkit:1234 in the compose stack.
BUILDKIT_HOST=tcp://buildkit:1234

# Per-stage timeouts (minutes).
BUILD_TIMEOUT_MINUTES=30
TASK_TIMEOUT_MINUTES=45
IMAGE_PULL_TIMEOUT_MINUTES=10

# ─────────────────────────────────────────────────────────────────────────────
# Resource caps
# ─────────────────────────────────────────────────────────────────────────────

# Per-user concurrency caps. Tune up only if you have a single trusted operator;
# defaults are conservative for shared installs.
MAX_TERMINAL_SESSIONS_PER_USER=5
MAX_WEBSOCKET_CONNS_PER_USER=20

# ─────────────────────────────────────────────────────────────────────────────
# Preview environments
# ─────────────────────────────────────────────────────────────────────────────

# Days a preview app may sit idle before the GC reaps it. 0 disables GC.
PREVIEW_IDLE_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# Observability (opt-in)
# ─────────────────────────────────────────────────────────────────────────────

# OpenTelemetry collector endpoint (gRPC). Empty = no-op tracer. The
# compose.observability.yml profile starts a Jaeger collector at jaeger:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true

# When non-empty, exposes /metrics on a separate listener (no auth) for
# Prometheus scraping. Typical: 127.0.0.1:9090. Empty = /metrics is mounted
# on the main router behind admin auth.
METRICS_BIND=

# ─────────────────────────────────────────────────────────────────────────────
# Email (SMTP)
# ─────────────────────────────────────────────────────────────────────────────

# Public-facing base URL of the dashboard. Required when SMTP is configured —
# used to construct password-reset and invitation links in outbound emails, and
# for OAuth / GitHub-App callback URLs. In local dev set this to the Vite origin
# (http://localhost:5173); the dev server proxies /api to the API.
# Example: https://paas.example.com
PUBLIC_BASE_URL=

# Optional public URL for inbound provider webhooks. Falls back to
# PUBLIC_BASE_URL when empty. GitHub rejects localhost webhook URLs at App
# creation, so in local dev point this at a tunnel (smee.io / cloudflared) to
# test push-triggered deploys; leave empty to create the App without webhooks.
# Example: https://abc123.ngrok-free.app
WEBHOOK_PUBLIC_URL=

# SMTP server hostname. When empty, the email service writes rendered messages
# to slog at INFO level instead of dialing (log-only / dev fallback).
SMTP_HOST=

# SMTP server port. Default: 587 (STARTTLS). Use 465 for implicit TLS.
SMTP_PORT=587

# SMTP authentication credentials. Leave empty for unauthenticated relays.
SMTP_USER=
SMTP_PASSWORD=

# Sender address and display name for outbound emails.
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Self-Hosted PaaS

# TLS mode for the SMTP connection.
#   starttls  — STARTTLS upgrade on port 587 (default, recommended)
#   tls       — implicit TLS on port 465
#   none      — plaintext (dev/internal relays only)
SMTP_TLS_MODE=starttls

# ─────────────────────────────────────────────────────────────────────────────
# Remote backup (S3-compatible object storage)
# ─────────────────────────────────────────────────────────────────────────────

# Master switch. When false, backup.sh skips the upload step entirely.
# Default: false.
BACKUP_REMOTE_ENABLED=false

# S3-compatible endpoint hostname (without scheme). Leave empty to use AWS S3.
# Examples:
#   s3.us-east-1.amazonaws.com  (AWS, default when empty)
#   s3.us-west-004.backblazeb2.com  (Backblaze B2)
#   <account-id>.r2.cloudflarestorage.com  (Cloudflare R2)
#   <host>:<port>  (self-hosted MinIO)
BACKUP_S3_ENDPOINT=

# AWS region. Used for AWS S3 and bucket region selection. Ignored by most
# other providers but required by MinIO for the S3 API path.
BACKUP_S3_REGION=us-east-1

# Bucket name. Must already exist (or be created by EnsureBucket in tests).
BACKUP_S3_BUCKET=

# Access credentials. For R2, use an API token pair. For B2, use keyID/appKey.
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Key prefix inside the bucket. All backup objects are written under this path.
# Default: paas/
BACKUP_S3_PREFIX=paas/

# Whether to use TLS for the S3 connection. Set to false for a local MinIO
# development instance. Default: true.
BACKUP_S3_USE_SSL=true

# Rotation policy: delete objects older than BACKUP_RETAIN_DAYS days AND
# always keep the BACKUP_RETAIN_COUNT most recent objects regardless of age.
# The rotation task runs daily via the asynq scheduler (Phase 6).
BACKUP_RETAIN_DAYS=30
BACKUP_RETAIN_COUNT=14

# Path to backup.sh on the host/container filesystem.
# Defaults to $PAAS_DIR/scripts/backup.sh (i.e. /opt/paas/scripts/backup.sh).
# Override when PAAS_DIR is non-standard or the script lives elsewhere.
# BACKUP_SCRIPT_PATH=

# Optional: local backup encryption key (age public key or path to file). Set
# this in .env to have backup.sh encrypt archives before uploading.
# BACKUP_ENCRYPTION_KEY=age1...

# Local directory where managed-database logical dumps are written before upload.
# The Docker image sets this to /data/backups/databases (a paas-owned dir backed by
# the `paasdata` volume in docker-compose.prod.yml). Defaults to
# $PAAS_DIR/backups/databases when unset (bare-metal installs).
# DATABASE_BACKUP_DIR=/data/backups/databases

# ─────────────────────────────────────────────────────────────────────────────
# Compose-only knobs (read by docker-compose.prod.yml, not the API)
# ─────────────────────────────────────────────────────────────────────────────

# Pinned image tag. Override during upgrades or to test a release candidate.
PAAS_IMAGE=ghcr.io/ungweiliang/selfhost-paas:latest

# Postgres credentials baked into the postgres container on first boot.
# Change these BEFORE the first `docker compose up`; rotating after has to go
# through `ALTER USER` inside the running container.
POSTGRES_USER=paas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=paas
