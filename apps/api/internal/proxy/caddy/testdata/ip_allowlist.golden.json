[
  {
    "handler": "subroute",
    "routes": [
      {
        "handle": [
          {
            "body": "Forbidden",
            "handler": "static_response",
            "status_code": "403"
          }
        ],
        "match": [
          {
            "not": [
              {
                "remote_ip": {
                  "ranges": [
                    "10.0.0.0/8",
                    "192.168.1.0/24"
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
]
