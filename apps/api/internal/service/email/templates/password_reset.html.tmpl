<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><meta name="referrer" content="no-referrer"></head>
<body style="font-family:sans-serif;max-width:560px;margin:40px auto;color:#1a1a1a">
  <h2>Reset your password</h2>
  <p>Hi {{.FirstName}},</p>
  <p>We received a request to reset your password. Click the button below to set a new password:</p>
  <p style="margin:32px 0">
    <a href="{{.ResetURL}}" style="background:#2563eb;color:#fff;padding:12px 24px;border-radius:6px;text-decoration:none;font-weight:600">Reset password</a>
  </p>
  <p style="font-size:0.875rem;color:#6b7280">This link expires in 30 minutes. If you didn't request a password reset, you can safely ignore this email.</p>
  <hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0">
  <p style="font-size:0.75rem;color:#9ca3af">Self-Hosted PaaS</p>
</body>
</html>
